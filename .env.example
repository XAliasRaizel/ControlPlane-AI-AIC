CONTROLPLANE_DB_PATH=controlplane.db
CONTROLPLANE_LOG_LEVEL=INFO
CONTROLPLANE_ASYNC_DELAY_MS=50
CONTROLPLANE_POLICIES_DIR=policies
# Use a unique, secret value outside source control in any shared environment.
CONTROLPLANE_AUDIT_HASH_KEY=local-prototype-not-a-secret
CONTROLPLANE_MAX_PROMPT_CHARS=12000

# --- Security: API Key Authentication ---
# Comma-separated list of valid API keys. If unset, falls back to hardcoded
# demo keys (demo-key-001, demo-key-002, test-key) with a loud WARNING log.
# In production, set this to one or more strong random secrets.
CONTROLPLANE_API_KEYS=

# --- Security: Admin-Only API Keys ---
# Comma-separated list of keys that unlock admin endpoints
# (/admin/reload-models, /v1/ask-controlplane/reindex).
# If unset, falls back to demo admin key (admin-key-001) with a WARNING.
CONTROLPLANE_ADMIN_KEYS=

# --- Security: CORS Allowed Origins ---
# Comma-separated list of origins allowed by the CORS policy.
# Default allows the local Streamlit frontend.
CONTROLPLANE_CORS_ORIGINS=http://localhost:8501

# --- Security: Rate Limiting ---
# Max requests per minute for /v1/govern and /v1/chat (heavy inference endpoints).
CONTROLPLANE_RATE_LIMIT_GOVERN=60
# Max requests per minute for all other authenticated endpoints.
CONTROLPLANE_RATE_LIMIT_DEFAULT=120

# --- Groq LLM (Ask ControlPlane generative answers) ---
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.3
RAG_GENERATION_ENABLED=true

# --- Scalability ---
# Session TTL: how many hours SQLiteSessionStore keeps sessions before vacuuming them.
CONTROLPLANE_SESSION_TTL_HOURS=24
# Async task queue size: max buffered background tasks before back-pressure drops them.
CONTROLPLANE_ASYNC_QUEUE_SIZE=500
# Metrics cache TTL: seconds to cache /v1/metrics and /v1/audits to avoid repeated heavy DB scans.
CONTROLPLANE_METRICS_CACHE_TTL_S=60

# --- Async LLM Judge (Deep Background Analysis) ---
# Provider for semantic LLM-as-judge in the async path: groq | openai | anthropic | mock (default)
# Uses the same GROQ_API_KEY already configured for RAG generation — no extra cost.
# Set to 'groq' to enable deep hallucination, bias, and jailbreak LLM analysis.
CP_JUDGE_PROVIDER=groq
# Model to use for the LLM judge. For Groq: llama3-8b-8192 (fast) or llama-3.1-70b-versatile (smart).
CP_JUDGE_MODEL=llama3-8b-8192
# For OpenAI: gpt-4o-mini. For Anthropic: claude-haiku-4-5-20251001.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Async LLM Sampling Gate ---
# Risk threshold above which 100% of requests get full async LLM analysis (default: 0.20).
# Requests with hot-path risk >= this value always get the full LLM engine pass.
CONTROLPLANE_ASYNC_LLM_RISK_THRESHOLD=0.20
# Fraction of benign (risk below threshold) requests sampled for background drift monitoring (default: 5%).
CONTROLPLANE_ASYNC_LLM_SAMPLE_RATE=0.05

# ===========================================================================
# OBSERVABILITY (Phase 7)
# ===========================================================================

# --- Structured JSON Logging ---
# Set to true in containers / CI for machine-readable log streams compatible
# with ELK, Datadog, Google Cloud Logging, etc.
# Each log line is emitted as a single JSON object with fields:
#   time, level, logger, message, request_id, trace_id, + any extras.
# Default: false (human-readable plain text for local development)
CONTROLPLANE_JSON_LOGS=false

# --- OpenTelemetry Distributed Tracing ---
# Set CONTROLPLANE_OTLP_ENDPOINT to enable OTel trace export.
# Examples:
#   Jaeger all-in-one:  http://localhost:4318/v1/traces
#   Grafana Tempo:      http://tempo:4318/v1/traces
#   Honeycomb:          https://api.honeycomb.io/v1/traces  (requires HONEYCOMB_API_KEY header)
# Leave empty (default) for no-op tracing (zero overhead, no external dependency).
CONTROLPLANE_OTLP_ENDPOINT=

# Service name reported in traces and structured logs.
CONTROLPLANE_OTEL_SERVICE_NAME=controlplane-api
