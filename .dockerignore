# Git & CI
.git/
.gitignore
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local env and secrets
.env
*.env

# Virtual environments
venv/
.venv/
env/

# Python build artifacts
*.egg-info/
dist/
build/
*.whl

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Runtime data (mounted via volume in Docker)
controlplane.db
controlplane.integrity.jsonl
*.db-shm
*.db-wal
/data/

