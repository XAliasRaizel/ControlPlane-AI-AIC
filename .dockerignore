rag/corpus/
rag/__pycache__/

# ML model artifacts (large, downloaded at runtime)
ml/models/
*.onnx
*.pt
*.bin

# Scratch / test output
scratch/
*.log
test-results.xml
audit-report.json

# Docs / extras not needed in image
*.md
plan.md
HANDOFF*
!requirements.txt